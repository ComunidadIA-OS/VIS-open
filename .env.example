# Copia a .env (ignorado por git). Nunca subas valores reales.
HF_TOKEN=            # token de Hugging Face para pyannote (modelo restringido)
LLM_BASE_URL=http://localhost:8080/v1   # servidor local compatible con OpenAI
LLM_API_KEY=         # opcional; nunca en el repo
LLM_MODEL=           # p. ej. qwen3 (llama-server) o nimble (Ollama); nunca nimble-v3
DECISION_ENGINE=rules   # rules | llm (laya, nimble y kev se usan como LLM_MODEL con el motor llm)
DATA_DIR=./data
# Transcripción (faster-whisper + WhisperX). Vacío = valor por defecto.
WHISPER_DEVICE=cpu      # cpu | cuda (V100S en OVH)
WHISPER_MODEL=          # por defecto: small en cpu, large-v3 en cuda
WHISPER_COMPUTE_TYPE=   # por defecto: int8 en cpu, float16 en cuda; nunca bfloat16 (Volta)
WHISPER_LANGUAGE=es     # vacío = detección automática
WHISPER_ALIGN=1         # 0 = sin alineado WhisperX
# Diarización (pyannote, usa HF_TOKEN)
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
PYANNOTE_METRICS_ENABLED=0   # telemetría de pyannote desactivada
# Fuente Congreso: descarga automática desactivada hasta comprobar robots.txt de app.congreso.es
AUTO_DOWNLOAD=false
# Vídeo: ruta al modelo de pose de MediaPipe (.task); no va en el repo
POSE_MODEL=
# Coste de la API del LLM: precios del tarifario del proveedor (no hay valores por defecto)
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=
LLM_PRICE_CURRENCY=EUR
LLM_PRICE_DATE=
# Opcional: parámetros extra del proveedor (JSON) y tope de tokens de salida. Ejemplo para quitar el
# razonamiento de Qwen 3 en OVH AI Endpoints: LLM_EXTRA_BODY={"reasoning_effort":"none"}
LLM_EXTRA_BODY=
LLM_MAX_TOKENS=
